# Where the SQLite file lives. Use :memory: for a throwaway database.
DATABASE_PATH=./data/greenquote.db
# Secret used to sign session tokens. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
# Admin account created on first start
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=admin1234
